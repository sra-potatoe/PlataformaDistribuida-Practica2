# Copiar como config/.env y completar. NUNCA subir config/.env al repo.

# === JWT ===
JWT_SECRET_KEY=cambia_esto_por_una_clave_segura_asfi_2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=5

# === PostgreSQL (Bancos 1-3) ===
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=tu_password_aqui

PG_DB_UNION=banco_union
PG_DB_MERCANTIL=banco_mercantil
PG_DB_BNB=banco_bnb

# === SQL Server (Bancos 4-6) ===
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=tu_password_aqui
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

SQLSERVER_DB_BCP=banco_bcp
SQLSERVER_DB_BISA=banco_bisa
SQLSERVER_DB_GANADERO=banco_ganadero

# === MySQL (Bancos 7-9) ===
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=tu_password_aqui

MYSQL_DB_ECONOMICO=banco_economico
MYSQL_DB_PRODEM=banco_prodem
MYSQL_DB_SOLIDARIO=banco_solidario

# === Firebase (Bancos 13-14) ===
FIREBASE_CREDENTIALS_PATH=keys/firebase_credentials.json
FIREBASE_PROJECT_ID=asfi-project

# === ASFI Central ===
PG_ASFI_HOST=localhost
PG_ASFI_PORT=5432
PG_ASFI_USER=postgres
PG_ASFI_PASSWORD=tu_password_aqui
PG_ASFI_DB=asfi_central

# === Tipo de Cambio ===
BCB_TC_BASE=6.9600
BCB_TC_VARIACION_MAX=0.9999
BCB_TC_INTERVALO_MINUTOS=3

# === Certificados ===
SSL_CERTFILE=keys/certs/server.pem
SSL_KEYFILE=keys/certs/server.key
